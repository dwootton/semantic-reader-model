  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-hierarchy-judge:result:0.1",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "source",
            "candidate",
            "image",
            "trace",
            "preflight",
            "capture",
            "context"
